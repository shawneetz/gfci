
# -----------------------------------------------------------------------------
# Database (Postgres, via Prisma) — required
# -----------------------------------------------------------------------------
# Two separate connection strings are required. See prisma.config.ts and
# src/lib/prisma.ts.
#
#   DATABASE_URL — the app's RUNTIME connection (src/lib/prisma.ts). Point
#     this at a POOLED connection (PgBouncer, Supabase's "Transaction
#     pooler" port, Neon's pooled endpoint, etc.) — every page on the site
#     is `force-dynamic` (Phase 9), so this string gets hit on every single
#     request.
#
#   DIRECT_URL — an UNPOOLED connection, used only by CLI operations:
#     `npm run db:migrate`, `npm run db:seed`, `npm run db:studio`,
#     `npm run admin:create`, `npm run backfill:images`. Prisma Migrate
#     cannot run schema changes through a PgBouncer-style pooler
#     (see prisma.config.ts's comment), so this must bypass the pooler.
#
# If your provider only gives you one (non-pooled) connection string,
# set both variables to that same value.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"


# -----------------------------------------------------------------------------
# Object storage — Vercel Blob (Phase 12) — required for image uploads
# -----------------------------------------------------------------------------
# Consumed by src/lib/storage.ts's uploadImage() (used today by
# scripts/backfill-images.ts; will be used by every Phase 15 admin
# create/edit form once those exist). @vercel/blob's put() reads this
# automatically — it isn't passed explicitly in code.
#
# Get a value: Vercel dashboard → Storage → Create Database → Blob → copy
# the "BLOB_READ_WRITE_TOKEN" it gives you. If the project is already
# linked to Vercel, `vercel env pull .env.local` will fetch it for you.
#
# Not required for `npm run dev` unless you're testing an image upload path
# or running `npm run backfill:images`.

BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"


# -----------------------------------------------------------------------------
# Admin authentication — Auth.js / NextAuth v5 (Phase 13) — required
# -----------------------------------------------------------------------------
# AUTH_SECRET signs/encrypts the admin session JWT (src/auth.ts uses
# `session: { strategy: "jwt" }`). Required in every environment, including
# local dev — sign-in at /admin/login will fail without it. Generate one
# with:
#   npx auth secret
# or:
#   openssl rand -base64 33
# Rotating this value invalidates every existing admin session.

AUTH_SECRET=""

# AUTH_URL is NOT required locally or on Vercel — src/auth.config.ts sets
# `trustHost: true`, so Auth.js infers the host from the incoming request
# instead. Only uncomment this if you're running behind a reverse proxy or
# tunnel that Auth.js can't correctly infer the host through.
# AUTH_URL="http://localhost:3000"

# Public site URL used for the sitemap and metadata, e.g. https://goldenfaith.church
NEXT_PUBLIC_SITE_URL=""


# -----------------------------------------------------------------------------
# Admin account bootstrap — reference only, not an env var
# -----------------------------------------------------------------------------
# There is no public sign-up route for /admin (see design-notes.md and
# semi-cms-checklist.md's Phase 13). Once DIRECT_URL above is set, create
# the first admin user with:
#
#   npm run admin:create -- "you@goldenfaith.church" "a-strong-password" "Your Name"
#
# Password must be at least 8 characters (enforced in scripts/create-admin.ts).
# Re-running the command for the same email updates that user's password
# instead of creating a duplicate (it's an upsert).